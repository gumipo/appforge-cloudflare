{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "tests"]
}

